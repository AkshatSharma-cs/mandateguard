PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_BUSINESS_EMAIL=
APP_BASE_URL=http://localhost:3000
PORT=3000
DB_PATH=./mandateguard.db
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-3.8-flash
LLM_MODE=replay
# Gemini automatically falls back to Gemini 3.5 Flash-Lite with the same key.
# Override the fallback model/provider below if needed. A different provider
# needs its own LLM_FALLBACK_API_KEY.
# LLM_FALLBACK_PROVIDER=anthropic
# LLM_FALLBACK_MODEL=your-supported-anthropic-model
# LLM_FALLBACK_API_KEY=
CHANNEL3_API_KEY=
CHANNEL3_API_URL=https://api.trychannel3.com
CHANNEL3_REGION=US
INCLUDE_DEMO_LISTINGS=false
DEMO_STORE_DOMAINS=
MAX_LLM_CALLS_PER_RUN=20
